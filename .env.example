# =========================
# OpenAI
# =========================
# API key de OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar. Por defecto usamos uno barato.
# Ejemplos: gpt-4o-mini, gpt-4.1-mini, gpt-4o
OPENAI_MODEL=gpt-4o-mini

# =========================
# NewsAPI (opcional)
# =========================
# https://newsapi.org/  (plan gratuito disponible)
# Si no se entrega, el script usa solamente fuentes RSS gratuitas.
NEWS_API_KEY=

# =========================
# Gmail (envío del briefing)
# =========================
# Tu correo Gmail completo, ej: tu.cuenta@gmail.com
GMAIL_USER=tu.cuenta@gmail.com

# App Password de 16 caracteres (NO es tu password normal de Gmail).
# Generar en: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Destinatario del briefing. Si se deja vacío, se envía a GMAIL_USER.
EMAIL_TO=

# =========================
# Configuración opcional
# =========================
# Cantidad máxima de noticias prefiltradas que se envían al modelo.
MAX_NEWS_TO_MODEL=40

# Idioma del briefing final (es / en). Por defecto es.
BRIEFING_LANG=es

# Zona horaria usada al renderizar la fecha del asunto del mail.
TIMEZONE=America/Santiago

# Si DRY_RUN=true, no envía mail e imprime el briefing por consola.
DRY_RUN=false
