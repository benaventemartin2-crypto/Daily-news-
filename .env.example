# =========================
# Provider de IA
# =========================
# Opciones: gemini (gratis), groq (gratis), openai (pago)
AI_PROVIDER=gemini

# Modelo a usar. Si se deja vacío, se usa el modelo por defecto del provider:
#   gemini -> gemini-2.5-flash
#   groq   -> llama-3.3-70b-versatile
#   openai -> gpt-4o-mini
#
# Para el nuevo briefing extenso (1.200-1.800 palabras) recomendamos un modelo
# con buen razonamiento: gemini-2.5-pro, gpt-4o, gpt-4.1-mini o claude-sonnet vía openai-compatible.
AI_MODEL=

# =========================
# Google Gemini (GRATIS)
# =========================
# Plan gratuito sin tarjeta de crédito.
# Generar key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# =========================
# Groq (GRATIS)
# =========================
# Plan gratuito con Llama 3.3. Muy rápido.
# Generar key en: https://console.groq.com/keys
GROQ_API_KEY=

# =========================
# OpenAI (PAGO)
# =========================
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =========================
# NewsAPI (opcional)
# =========================
# Sólo agrega cobertura adicional. La app funciona perfectamente sin esta key
# usando los feeds RSS gratuitos de Reuters, BBC, NYT, FT, WSJ, Diario Financiero,
# La Tercera, BioBio, Emol, Ex-Ante, etc.
# https://newsapi.org/
NEWS_API_KEY=

# =========================
# Indicadores económicos
# =========================
# La app obtiene indicadores reales (USD, UF, UTM, IPSA, cobre, Brent, WTI,
# S&P 500, Nasdaq, Bitcoin, TPM, IPC) desde fuentes públicas SIN API key:
#   - mindicador.cl (Banco Central de Chile / SII)
#   - stooq.com     (mercados internacionales)
# Si una fuente falla, el indicador se marca como "no disponible". Nunca se inventan datos.
# Para desactivar la recolección de mercado en local (debug), setear:
# SKIP_MARKET=true

# =========================
# Memoria editorial
# =========================
# La app guarda los últimos 7 días de temas en data/memory.json para dar
# continuidad al briefing ("se suma a la semana marcada por...").
# El workflow de GitHub Actions commitea ese archivo automáticamente.
# Para desactivar (debug):
# SKIP_MEMORY=true

# =========================
# Gmail (envío del briefing)
# =========================
GMAIL_USER=tu.cuenta@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_TO=

# =========================
# Configuración opcional
# =========================
# Cantidad máxima de noticias enviadas al modelo (default: 60).
# Subimos respecto al esquema anterior porque el briefing nuevo es más extenso.
MAX_NEWS_TO_MODEL=60
BRIEFING_LANG=es
TIMEZONE=America/Santiago
DRY_RUN=false
